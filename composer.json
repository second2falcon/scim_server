{
	"name": "second2falcon/scim_server",
	"description": "SCIM 2.0 server for Nextcloud: provision, update, disable and delete accounts from an identity provider such as authentik",
	"license": "AGPL-3.0-or-later",
	"type": "project",
	"autoload": {
		"psr-4": {
			"OCA\\ScimServer\\": "lib/"
		}
	},
	"require": {
		"php": "^8.2"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable33",
		"phpunit/phpunit": "^11.5",
		"psalm/phar": "^6.20"
	},
	"scripts": {
		"lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
		"psalm": "psalm.phar --no-cache --threads=1",
		"test:unit": "phpunit -c tests/phpunit.xml"
	},
	"config": {
		"platform": {
			"php": "8.2"
		},
		"sort-packages": true
	}
}
